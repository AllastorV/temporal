{
    Tools = ordered() {
        TemporalLensBackgroundBlur = MacroOperator {
            Inputs = ordered() {
                Source = InstanceInput { SourceOp = "LensProfile", Source = "Source", Name = "Source" },
                OpenPanel = InstanceInput { SourceOp = "LensProfile", Source = "temporal_open_panel", Name = "Temporal Panel" },
                Lens = InstanceInput { SourceOp = "LensProfile", Source = "lens_model", Name = "Lens", Default = 0 },
                LensBlur = InstanceInput { SourceOp = "LensProfile", Source = "lens_blur", Name = "Background Blur", Default = 0 },
                BlurAmount = InstanceInput { SourceOp = "LensProfile", Source = "lens_blur_amount", Name = "Blur Amount", Default = 1 },
                Aperture = InstanceInput { SourceOp = "LensProfile", Source = "lens_stop", Name = "Aperture (T/F)", Default = 0 },
                Zoom = InstanceInput { SourceOp = "LensProfile", Source = "lens_focal", Name = "Zoom Focal Length (mm)", Default = 28 },
                Focus = InstanceInput { SourceOp = "LensProfile", Source = "focus_distance", Name = "AI Focus Distance", Default = 0.75, MinScale = 0, MaxScale = 1 },
                FocusRange = InstanceInput { SourceOp = "LensProfile", Source = "focus_range", Name = "In-Focus Range", Default = 0.12 },
                TiltX = InstanceInput { SourceOp = "LensProfile", Source = "focus_tilt_x", Name = "Focus Tilt X (left / right)", Default = 0, MinScale = -0.5, MaxScale = 0.5 },
                TiltY = InstanceInput { SourceOp = "LensProfile", Source = "focus_tilt_y", Name = "Focus Tilt Y (bottom / top)", Default = 0, MinScale = -0.5, MaxScale = 0.5 },
                BlurForeground = InstanceInput { SourceOp = "LensProfile", Source = "blur_foreground", Name = "Blur Foreground", Default = 0 },
                UseFocusPull = InstanceInput { SourceOp = "LensProfile", Source = "use_focus_pull", Name = "Use A/B/C Focus Pull", Default = 0 },
                FocusA = InstanceInput { SourceOp = "LensProfile", Source = "focus_a", Name = "Focus A", Default = 0.78 },
                FocusB = InstanceInput { SourceOp = "LensProfile", Source = "focus_b", Name = "Focus B", Default = 0.52 },
                FocusC = InstanceInput { SourceOp = "LensProfile", Source = "focus_c", Name = "Focus C", Default = 0.28 },
                PullPosition = InstanceInput { SourceOp = "LensProfile", Source = "pull_position", Name = "Pull Position (0 A / 1 B / 2 C)", Default = 0 },
                FocusColor = InstanceInput { SourceOp = "LensProfile", Source = "focus_color", Name = "Focus Color Preview", Default = 0 },
                SubjectMatte = InstanceInput { SourceOp = "MatteSource", Source = "Image2", Name = "Subject Matte" },
                SubjectMatteStrength = InstanceInput { SourceOp = "LensProfile", Source = "matte_strength", Name = "Subject Matte Strength", Default = 0, Page = "Controls", MinScale = 0, MaxScale = 1 },
                MatteFeather = InstanceInput { SourceOp = "LensProfile", Source = "matte_feather", Name = "Matte Feather (px)", Default = 0.8, MinScale = 0, MaxScale = 4 },
                InputEncoding = InstanceInput { SourceOp = "LensProfile", Source = "encoding", Name = "Input Encoding", Default = 1 },
            },
            Outputs = ordered() {
                Output = InstanceOutput { SourceOp = "ChoosePreview", Source = "Output" },
            },
            ViewInfo = GroupInfo { Pos = { 0, 0 } },
            Tools = ordered() {
                LensProfile = ofx.com.temporal.lens_character {
                    Inputs = {
                        lens_model = Input { Value = 0 },
                        lens_blur = Input { Value = 0 },
                        lens_blur_amount = Input { Value = 1 },
                        lens_stop = Input { Value = 0 },
                        lens_focal = Input { Value = 28 },
                        fallback_blur = Input { Value = 0 },
                        lens_fusion_controls = Input { Value = 1 },
                        encoding = Input { Value = 1 },
                    },
                    ViewInfo = OperatorInfo { Pos = { 0, 0 } },
                },
                StudioBokeh = ofx.com.blackmagicdesign.resolvefx.CineFocus {
                    Inputs = {
                        Source = Input { SourceOp = "LensProfile", Source = "Output" },
                        Blend = Input { Value = 0, Expression = "iif(LensProfile.lens_blur_amount > 0, LensProfile.lens_blur, 0)" },
                        ProcessWhenBlendIs00 = Input { Value = 0 },
                        focusIsNoFg = Input { Value = 1, Expression = "1 - LensProfile.blur_foreground" },
                        fgPostIsEnabled = Input { Value = 1 },
                        focusDistance = Input { Value = 0.75, Expression = "iif(LensProfile.use_focus_pull > 0, LensProfile.focus_a + (LensProfile.focus_b - LensProfile.focus_a)*min(max(LensProfile.pull_position,0),1) + (LensProfile.focus_c - LensProfile.focus_b)*min(max(LensProfile.pull_position-1,0),1), RefinedDepth.NumberIn2)" },
                        focusExtendRange = Input { Value = 0.12, Expression = "LensProfile.focus_range" },
                        apertureisShaped = Input { Value = 0, Expression = "iif(LensProfile.lens_model >= 2, 1, 0)" },
                        apertureNumBlades = Input { Value = 6, Expression = "iif(LensProfile.lens_model == 2, 13, iif(LensProfile.lens_model == 3, 9, 6))" },
                        apertureCurvature = Input { Value = 0.84, Expression = "iif(LensProfile.lens_model == 2, 0.65, 0.84)" },
                        apertureFaster = Input { Value = 1, Expression = "LensProfile.lens_blur_amount * iif(LensProfile.lens_model == 2, 0.72 + 0.55 * (LensProfile.lens_focal - 28) / 72, iif(LensProfile.lens_model == 1, 1.20, iif(LensProfile.lens_model == 3, 0.96, 1.0))) * RefinedDepth.NumberIn7 / min(max(LensProfile.lens_stop, RefinedDepth.NumberIn7), iif(LensProfile.lens_model == 3, 16, 22))" },
                        apertureEnhanced = Input { Value = 0.5, Expression = "0.5 * StudioBokeh.apertureFaster" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 165, 0 } },
                },
                DepthAnalysis = ofx.com.blackmagicdesign.resolvefx.CineFocus {
                    Inputs = {
                        Source = Input { SourceOp = "LensProfile", Source = "Output" },
                        preview = Input { Value = FuID { "PreviewDepth" } },
                    },
                    ViewInfo = OperatorInfo { Pos = { 165, 75 } },
                },
                MatteSource = Custom {
                    Inputs = {
                        Image1 = Input { SourceOp = "LensProfile", Source = "Output" },
                        RedExpression = Input { Value = "0" },
                        GreenExpression = Input { Value = "0" },
                        BlueExpression = Input { Value = "0" },
                        AlphaExpression = Input { Value = "r2" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 0, 150 } },
                },
                MatteWarp = ofx.com.temporal.lens_character {
                    Inputs = {
                        Source = Input { SourceOp = "MatteSource", Source = "Output" },
                        lens_model = Input { Expression = "LensProfile.lens_model" },
                        lens_focal = Input { Expression = "LensProfile.lens_focal" },
                        lens_distortion = Input { Expression = "LensProfile.lens_distortion" },
                        sensor_diagonal = Input { Expression = "LensProfile.sensor_diagonal" },
                        optical_center = Input { Expression = "LensProfile.optical_center" },
                        lens_outside = Input { Expression = "LensProfile.lens_outside" },
                        lens_edge_blur = Input { Value = 0 },
                        lens_blur = Input { Value = 0 },
                        encoding = Input { Value = 0 },
                    },
                    ViewInfo = OperatorInfo { Pos = { 165, 150 } },
                },
                RefinedDepth = Custom {
                    Inputs = {
                        Image1 = Input { SourceOp = "LensProfile", Source = "Output" },
                        Image2 = Input { SourceOp = "DepthAnalysis", Source = "Output" },
                        Image3 = Input { SourceOp = "MatteWarp", Source = "Output" },
                        NumberIn1 = Input { Value = 0, Expression = "LensProfile.matte_strength" },
                        NumberIn2 = Input { Value = 0.75, Expression = "LensProfile.focus_distance" },
                        NumberIn3 = Input { Value = 0, Expression = "LensProfile.focus_tilt_x" },
                        NumberIn4 = Input { Value = 0, Expression = "LensProfile.focus_tilt_y" },
                        NumberIn5 = Input { Value = 0.8, Expression = "LensProfile.matte_feather" },
                        NumberIn6 = Input { Expression = "1 - RefinedDepth.NumberIn2" },
                        NumberIn7 = Input { Expression = "iif(LensProfile.lens_model == 2, 2.9, iif(LensProfile.lens_model == 1, 1.4, iif(LensProfile.lens_model == 3, 1.2, 1.8)))" },
                        Setup1 = Input { Value = "max(n5,0)/max(w1,1)" },
                        Setup2 = Input { Value = "max(n5,0)/max(h1,1)" },
                        Intermediate1 = Input { Value = "if(n1 > 0 and n5 > 0, (4*a3 + 2*(geta3d(x-s1,y)+geta3d(x+s1,y)+geta3d(x,y-s2)+geta3d(x,y+s2)) + geta3d(x-s1,y-s2)+geta3d(x-s1,y+s2)+geta3d(x+s1,y-s2)+geta3d(x+s1,y+s2))/16, a3)" },
                        Intermediate2 = Input { Value = "if(n5 > 0, max(i1,0.85*a3), a3)" },
                        AlphaExpression = Input { Value = "min(max(r2 + max(n6-r2,0)*min(max(i2,0),1)*min(max(n1,0),1) - n3*(2*x-1) - n4*(2*y-1),0),1)" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 310, 75 } },
                },
                AssistedBokeh = ofx.com.blackmagicdesign.resolvefx.CineFocus {
                    Inputs = {
                        Source = Input { SourceOp = "RefinedDepth", Source = "Output" },
                        depthMapSource = Input { Value = FuID { "DepthMapSourceExternal" } },
                        finesseSplitting = Input { Value = 0 },
                        focusIsNoFg = Input { Value = 1, Expression = "StudioBokeh.focusIsNoFg" },
                        fgPostIsEnabled = Input { Value = 1 },
                        focusDistance = Input { Expression = "StudioBokeh.focusDistance" },
                        focusExtendRange = Input { Expression = "StudioBokeh.focusExtendRange" },
                        apertureisShaped = Input { Expression = "StudioBokeh.apertureisShaped" },
                        apertureNumBlades = Input { Expression = "StudioBokeh.apertureNumBlades" },
                        apertureCurvature = Input { Expression = "StudioBokeh.apertureCurvature" },
                        apertureFaster = Input { Expression = "StudioBokeh.apertureFaster" },
                        apertureEnhanced = Input { Expression = "StudioBokeh.apertureEnhanced" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 455, 75 } },
                },
                RestoreAlpha = Custom {
                    Inputs = {
                        Image1 = Input { SourceOp = "AssistedBokeh", Source = "Output" },
                        Image2 = Input { SourceOp = "LensProfile", Source = "Output" },
                        AlphaExpression = Input { Value = "a2" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 600, 75 } },
                },
                ChooseDepth = Dissolve {
                    Inputs = {
                        Background = Input { SourceOp = "StudioBokeh", Source = "Output" },
                        Foreground = Input { SourceOp = "RestoreAlpha", Source = "Output" },
                        Mix = Input { Expression = "iif((RefinedDepth.NumberIn1 > 0 or abs(RefinedDepth.NumberIn3) > 0 or abs(RefinedDepth.NumberIn4) > 0) and LensProfile.lens_blur > 0 and LensProfile.lens_blur_amount > 0, 1, 0)" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 745, 0 } },
                },
                FocusOverlay = Custom {
                    Inputs = {
                        Image1 = Input { SourceOp = "LensProfile", Source = "Output" },
                        Image2 = Input { SourceOp = "RefinedDepth", Source = "Output" },
                        NumberIn1 = Input { Expression = "1 - StudioBokeh.focusDistance" },
                        NumberIn2 = Input { Expression = "StudioBokeh.focusExtendRange" },
                        Intermediate1 = Input { Value = "0.6*min(max((0.045 + 0.5*n2 - abs(a2-n1))/0.045,0),1)" },
                        RedExpression = Input { Value = "r1*(1-i1) + 0.12*i1" },
                        GreenExpression = Input { Value = "g1*(1-i1) + 0.95*i1" },
                        BlueExpression = Input { Value = "b1*(1-i1) + 0.24*i1" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 745, 75 } },
                },
                ChoosePreview = Dissolve {
                    Inputs = {
                        Background = Input { SourceOp = "ChooseDepth", Source = "Output" },
                        Foreground = Input { SourceOp = "FocusOverlay", Source = "Output" },
                        Mix = Input { Expression = "LensProfile.focus_color" },
                    },
                    ViewInfo = OperatorInfo { Pos = { 910, 0 } },
                },
            },
        },
    },
    ActiveTool = "TemporalLensBackgroundBlur",
}
